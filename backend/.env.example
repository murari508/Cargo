# ---- Database (MySQL) -------------------------------------------------------
DB_USER=cargo
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cargo

# Optional: overrides everything above. Use sqlite for a zero-setup demo run:
# DATABASE_URL=sqlite:///./cargo.db
DATABASE_URL=

# ---- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_this_with_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ---- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Payments ---------------------------------------------------------------
# mock | razorpay | stripe  (only "mock" is implemented; others raise NotImplemented)
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

# ---- Speech / AI (optional; assistant works without these) ------------------
# When empty the backend uses its built-in multilingual rules engine and the
# browser's Web Speech API handles STT/TTS. Keys are never sent to the client.
SPEECH_PROVIDER=browser
SPEECH_API_KEY=
LLM_PROVIDER=rules
LLM_API_KEY=
